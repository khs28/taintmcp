  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "taintmcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khs28/taintmcp.git",
    "directory": "packages/gateway"
  },
  "homepage": "https://github.com/khs28/taintmcp#readme",
  "bugs": "https://github.com/khs28/taintmcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-security",
    "llm-security",
    "prompt-injection",
    "ai-agents",
    "gateway",
    "proxy"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^13.1.0",
