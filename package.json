{
  "name": "taintmcp",
  "private": true,
  "version": "0.1.0",
  "description": "Runtime, client-side security gateway for the Model Context Protocol (MCP).",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "demo": "npm run build --silent && node scripts/demo.mjs",
    "demo:m2": "npm run build --silent && node scripts/demo-m2.mjs",
    "demo:m3": "npm run build --silent && node scripts/demo-m3.mjs",
    "demo:m4": "npm run build --silent && node scripts/demo-m4.mjs",
    "dashboard": "npm run build --silent && node scripts/dashboard.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "jose": "6.2.4"
  }
}
